# ============================================================
# EU Publishing House — Production .htaccess
# - Pretty URLs: strip .php, force trailing slash, unknown -> /
# - Works in BOTH a subfolder install (e.g. XAMPP localhost
#   under /brands/eupublishinghouse.com/) AND a domain-root
#   production install.  No RewriteBase needed — the install
#   path is auto-detected into ENV:BASE on every request.
# - Compression (brotli + gzip), caching, security headers
# ============================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.php
ServerSignature Off
AddDefaultCharset UTF-8

# ============================================================
# REWRITE RULES — pretty URLs
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 0. Detect install base into ENV:BASE ------------------
    # After this rule, %{ENV:BASE} holds the directory this
    # .htaccess lives in, e.g. "/brands/eupublishinghouse.com/"
    # on XAMPP localhost, "/" on a domain-root install.
    RewriteCond %{REQUEST_URI}::$0  ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$  -  [E=BASE:%1]

    # --- 0b. Admin panel: pass through untouched ---------------
    #     Keep /admin/*.php working — no pretty-URL 301s, no rewrites.
    RewriteRule ^admin(/.*)?$  -  [L]

    # --- 1. Block direct access to private folders -------------
    RewriteRule ^(config|includes)/.*  -  [F,L]

    # --- 2. Block direct browsing of /blogs/ index -------------
    #     Individual blog pages still resolve via rules below.
    RewriteRule ^blogs/?$  %{ENV:BASE}  [R=301,L]

    # --- 3. Dynamic sitemap ------------------------------------
    RewriteRule ^sitemap\.xml$  sitemap.php  [L]

    # --- 4. Exempt the form handler ---------------------------
    #     POST requests must reach form-submission.php directly.
    RewriteRule ^form-submission\.php$  -  [L]

    # --- 5. /index.php and /index/ -> install root ------------
    RewriteRule ^index\.php$   %{ENV:BASE}  [R=301,L]
    RewriteRule ^index/?$      %{ENV:BASE}  [R=301,L]

    # --- 6. Strip .php from any URL (301 canonical) -----------
    #     /about.php?x=1  ->  /about/?x=1
    #     /blogs/slug.php ->  /blogs/slug/
    #     %1 captures the full path including leading slash, so
    #     this works regardless of install depth.
    RewriteCond %{THE_REQUEST}  \s([^\s?]+?)\.php([\s?])  [NC]
    RewriteRule ^  %1/  [R=301,L,NE,QSA]

    # --- 7. Add trailing slash for known pages (301) ----------
    #     /about  ->  /about/   (only when /about.php exists)
    #     %{DOCUMENT_ROOT}%{REQUEST_URI}.php  resolves to the
    #     real filesystem path, so it works in any install dir.
    RewriteCond %{REQUEST_FILENAME}                    !-f
    RewriteCond %{REQUEST_FILENAME}                    !-d
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php      -f
    RewriteRule ^(.+[^/])$  %{REQUEST_URI}/  [R=301,L,QSA]

    # --- 8. Internal rewrite: /page/ -> /page.php -------------
    #     Strip trailing slash from REQUEST_URI to test the
    #     .php existence at the right filesystem path.
    RewriteCond %{REQUEST_FILENAME}                    !-d
    RewriteCond %{REQUEST_URI}                         ^(.*?)/?$
    RewriteCond %{DOCUMENT_ROOT}%1.php                  -f
    RewriteRule ^(.+?)/?$  $1.php  [L,QSA]

    # --- 9. Catch-all: unknown URL -> install root ------------
    #     The unknown path is dropped entirely; browser URL
    #     becomes the homepage of THIS install (works in subfolder
    #     and root installs alike).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI}      !=%{ENV:BASE}
    RewriteRule ^.*  %{ENV:BASE}  [R=301,L]
</IfModule>

# ============================================================
# COMPRESSION — brotli (preferred) + gzip fallback
# ============================================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml image/x-icon
    AddOutputFilterByType BROTLI_COMPRESS font/woff2 font/woff font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf font/otf application/vnd.ms-fontobject
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|mp4|webm|zip|rar|gz|br)$ no-gzip dont-vary
</IfModule>

# ============================================================
# BROWSER CACHING
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                                "access plus 1 month"

    ExpiresByType text/html                       "access plus 0 seconds"
    ExpiresByType application/json                "access plus 0 seconds"
    ExpiresByType application/xml                 "access plus 1 hour"
    ExpiresByType text/xml                        "access plus 1 hour"

    ExpiresByType text/css                        "access plus 1 year"
    ExpiresByType application/javascript          "access plus 1 year"
    ExpiresByType text/javascript                 "access plus 1 year"

    ExpiresByType image/jpeg                      "access plus 1 year"
    ExpiresByType image/png                       "access plus 1 year"
    ExpiresByType image/gif                       "access plus 1 year"
    ExpiresByType image/webp                      "access plus 1 year"
    ExpiresByType image/avif                      "access plus 1 year"
    ExpiresByType image/svg+xml                   "access plus 1 year"
    ExpiresByType image/x-icon                    "access plus 1 year"

    ExpiresByType font/woff2                      "access plus 1 year"
    ExpiresByType font/woff                       "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject   "access plus 1 year"
    ExpiresByType font/ttf                        "access plus 1 year"
    ExpiresByType font/otf                        "access plus 1 year"

    ExpiresByType video/mp4                       "access plus 1 year"
    ExpiresByType video/webm                      "access plus 1 year"
    ExpiresByType audio/mpeg                      "access plus 1 year"
</IfModule>

# ============================================================
# CACHE-CONTROL HEADERS + SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html?|php)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

    Header set X-Content-Type-Options  "nosniff"
    Header set X-Frame-Options         "SAMEORIGIN"
    Header set Referrer-Policy         "strict-origin-when-cross-origin"
    Header set Permissions-Policy      "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header set X-XSS-Protection        "1; mode=block"

    Header unset ETag
</IfModule>
FileETag None

<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# ============================================================
# Block hidden / sensitive files
# ============================================================
<FilesMatch "^\.(htaccess|htpasswd|env|git.*|DS_Store)$">
    Require all denied
</FilesMatch>

<FilesMatch "(^|/)(composer\.(json|lock)|package(-lock)?\.json|\.gitignore|\.gitattributes|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(ini|log|sh|bak|sql|env)$">
    Require all denied
</FilesMatch>
