# Uploaded assets only — never execute code here.
php_flag engine off
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
AddType text/plain .php .phtml .phar
